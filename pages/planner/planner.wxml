<view class="container"><view class="banner">✨ 我的旅行计划</view><view class="field"><text>目的地</text><input value="{{city}}" bindinput="onCity" placeholder="例如：长沙"/></view><view class="field"><text>游玩天数（1～7天）</text><input type="number" value="{{days}}" bindinput="onDays"/></view><view class="field"><text>总预算（元，仅供记录）</text><input type="number" value="{{budget}}" bindinput="onBudget"/></view><button class="primary" bindtap="generate">生成并保存参考行程</button><view wx:if="{{plan.length}}" class="notice">以下为本地示例行程，不是实时 AI 推荐；开放时间、交通和费用请出行前核实。</view><view wx:for="{{plan}}" wx:key="day" class="card"><text class="day">第{{item.day}}天</text><text>{{item.activity}}</text></view></view>
