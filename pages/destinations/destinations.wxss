page{background:#f4f8ff}.container{padding:32rpx}.heading{font-size:42rpx;font-weight:bold;margin:30rpx 0}.card{display:flex;justify-content:space-between;align-items:center;background:white;border-radius:20rpx;padding:28rpx;margin:18rpx 0;box-shadow:0 5rpx 18rpx rgba(31,67,120,.05)}.copy{flex:1;padding-right:15rpx}.name{display:block;font-size:34rpx;font-weight:bold}.tag{display:block;color:#1677ff;font-size:24rpx;margin-top:10rpx}.desc{display:block;font-size:25rpx;color:#667085;margin-top:10rpx}.card button{margin:0;color:#1677ff;white-space:nowrap}.tip{color:#667085;font-size:24rpx;margin-top:25rpx}
