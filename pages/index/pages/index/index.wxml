
<view class="container">
  <view class="banner">
    <text class="title">🌍 趣游旅行攻略</text>
    <text class="subtitle">发现世界，开启美好旅程</text>
  </view>

  <view class="search">
    <input
      placeholder="搜索你想去的城市"
      bindinput="onSearchInput"
    />
  </view>

  <view class="section-title">🔥 热门旅游城市</view>

  <view
    class="city-card"
    wx:for="{{cities}}"
    wx:key="id"
    data-city="{{item.name}}"
    bindtap="openCity"
  >
    <text class="city-name">{{item.name}}</text>
    <text class="city-desc">{{item.desc}}</text>
  </view>

  <button class="planner-btn" bindtap="goPlanner">
    ✨ 开始规划我的旅行
  </button>
</view>
