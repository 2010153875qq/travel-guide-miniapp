<view class="container"><view class="heading">❤️ 我的收藏</view><view wx:if="{{!favorites.length}}" class="empty">还没有收藏，先去目的地页面看看吧。</view><view wx:for="{{favorites}}" wx:key="id" class="card" data-id="{{item.id}}" bindtap="openDetail"><view><text class="name">{{item.name}}</text><text class="desc">{{item.tag}}</text></view><button size="mini" data-id="{{item.id}}" catchtap="remove">取消收藏</button></view></view>
