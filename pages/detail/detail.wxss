page{background:#f4f8ff}.container{padding:32rpx}.hero{background:linear-gradient(135deg,#1677ff,#55c4ff);color:white;border-radius:28rpx;padding:55rpx 32rpx;box-shadow:0 14rpx 30rpx rgba(22,119,255,.18)}.name{display:block;font-size:52rpx;font-weight:bold}.tag{display:block;font-size:28rpx;margin-top:16rpx;color:#eaf6ff}.desc{display:block;font-size:26rpx;margin-top:18rpx;line-height:1.6;color:#f5fbff}.section{background:white;border-radius:22rpx;padding:28rpx;margin-top:22rpx}.section-title{font-size:32rpx;font-weight:bold;margin-bottom:20rpx}.highlight{display:flex;gap:14rpx;color:#465266;font-size:27rpx;margin:16rpx 0}.dot{color:#1677ff}.address{display:block;color:#667085;font-size:26rpx;line-height:1.6}.map-btn{color:#1677ff;background:#edf5ff;margin-top:22rpx}.actions{display:flex;gap:18rpx;margin-top:24rpx}.actions button{flex:1;margin:0;background:white;color:#1677ff}.actions .primary{background:#1677ff;color:white}.tip{font-size:24rpx;color:#667085;line-height:1.6;margin:25rpx 5rpx}
